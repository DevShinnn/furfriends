# Copy to .env and fill in. Load before starting the server.
# Base model on Hugging Face, and the LoRA adapter you trained (leave empty to run the base model).
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
ADAPTER_PATH=
# Saved with every rating in the app, so you can compare versions. Change it after each retrain.
MODEL_VERSION=base
MAX_NEW_TOKENS=350
# Same values as the app's VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY (used to check logins).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_ORIGINS=https://furfriends-black.vercel.app,http://localhost:5173
