# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The publishable key is safe to ship in the browser; Row Level Security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The FurFriends assistant (the team's own model). Leave the URL empty to keep it switched off
# for real accounts; the demo account always gets sample answers. See src/lib/assistant.js for
# the request and response format.
VITE_ASSISTANT_URL=

# Web push for reminders when the app is closed. Generate a VAPID key pair; the public key goes
# here and the private key goes to the send-reminders Edge Function's secrets (never in the app).
VITE_VAPID_PUBLIC_KEY=
