# Never upload secrets or local state to Vercel. The build only needs the app source.
.env.local
.env*.local
*.local.sql
supabase/
node_modules/
dist/
dev-dist/
.vercel/
# The AI's training files stay out; the Vercel function api/ask.py needs only these two.
ai-server/*
!ai-server/onnx_chat.py
!ai-server/prompting.py
